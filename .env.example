# App
APP_NAME=SaaS Template
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=saas_template

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Invitation System
INVITE_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5190

# CORS
CORS_ORIGINS=http://localhost:5190,http://localhost:5191,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Security (optional)
# INTERNAL_API_KEY=your_api_key_here

# Email SMTP Configuration
# Local (Mailcatcher): localhost:1025, no credentials
# Production (Brevo): smtp-relay.brevo.com:587, with credentials
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=SaaS Template
SMTP_TLS=false
SMTP_SSL=false
